{
  "name": "vextjs",
  "version": "0.1.0",
  "description": "VextJS is a modern Node.js web framework with adapter architecture, plugin system, and out-of-the-box features for building high-performance RESTful APIs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.js"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify/index.d.ts",
      "import": "./dist/adapters/fastify/index.js",
      "require": "./dist/adapters/fastify/index.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express/index.d.ts",
      "import": "./dist/adapters/express/index.js",
      "require": "./dist/adapters/express/index.js"
    },
    "./adapters/koa": {
      "types": "./dist/adapters/koa/index.d.ts",
      "import": "./dist/adapters/koa/index.js",
      "require": "./dist/adapters/koa/index.js"
    },
    "./adapters/native": {
      "types": "./dist/adapters/native/index.d.ts",
      "import": "./dist/adapters/native/index.js",
      "require": "./dist/adapters/native/index.js"
    }
  },
  "bin": {
    "vext": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:int": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:cov": "vitest run --coverage",
    "test:bench": "node test/benchmark/run-benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "framework",
    "web",
    "rest",
    "api",
    "adapter",
    "plugin",
    "hono",
    "typescript",
    "node"
  ],
  "author": "rocky <rockyshi1993@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vextjs/vext.git"
  },
  "bugs": {
    "url": "https://github.com/vextjs/vext/issues"
  },
  "homepage": "https://github.com/vextjs/vext#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "esbuild": "^0.27.3",
    "fast-glob": "^3.3.3",
    "find-my-way": "^9.5.0",
    "flex-rate-limit": "^1.0.3",
    "monsqlize": "^1.1.6",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "schema-dsl": "^1.2.2"
  },
  "peerDependencies": {
    "@hono/node-server": "^1.14.1",
    "express": "^5.0.0",
    "fastify": "^5.0.0",
    "hono": "^4.0.0",
    "koa": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@hono/node-server": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "koa": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.1",
    "@types/express": "^5.0.6",
    "@types/koa": "^3.0.1",
    "@types/node": "^22.15.17",
    "autocannon": "^8.0.0",
    "express": "^5.2.1",
    "fastify": "^5.7.4",
    "hono": "^4.7.6",
    "koa": "^3.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
